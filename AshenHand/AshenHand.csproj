<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Ashen Hand (docs/ashen-hand.md): a shadow order built on Rivalry Core. Its records are in AshenHand.mod, generated from the installed
    game by AshenHand.Data. Built against the game's and Rivalry Core's assemblies, never copied: the game loads them.
  -->

  <PropertyGroup>
    <AssemblyName>AshenHand</AssemblyName>
    <RootNamespace>AshenHand</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../engine/src/Meitou.Core/Meitou.Core.csproj" Private="false" />
    <ProjectReference Include="../engine/src/Meitou.Data/Meitou.Data.csproj" Private="false" />
    <ProjectReference Include="../engine/src/Meitou.Simulation/Meitou.Simulation.csproj" Private="false" />
    <ProjectReference Include="../engine/src/Meitou.Game/Meitou.Game.csproj" Private="false" />
    <ProjectReference Include="../RivalryCore/RivalryCore.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="meitou.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
