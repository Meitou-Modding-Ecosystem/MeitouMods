<Project Sdk="Microsoft.NET.Sdk">

  <!-- Vanilla edge seeding's tests (docs/vanilla-edges.md): places and roads made in memory, no game install needed. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Logistics.Edges.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.1.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../engine/src/Meitou.Simulation/Meitou.Simulation.csproj" />
    <ProjectReference Include="../LogisticsEdges/LogisticsEdges.csproj" />
  </ItemGroup>

</Project>
