<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Vanilla node seeding for Logistics Core (#59, docs/vanilla-nodes.md): every placed town as a node with its stable id, its owner and the
    owners the game's own town versions allow. A library, not a mod: Logistics Core takes it over when its repository exists. Built against
    the game's assemblies.
  -->

  <PropertyGroup>
    <AssemblyName>LogisticsSeed</AssemblyName>
    <RootNamespace>Logistics.Seed</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../engine/src/Meitou.Core/Meitou.Core.csproj" Private="false" />
    <ProjectReference Include="../engine/src/Meitou.Data/Meitou.Data.csproj" Private="false" />
    <ProjectReference Include="../engine/src/Meitou.Simulation/Meitou.Simulation.csproj" Private="false" />
  </ItemGroup>

</Project>
