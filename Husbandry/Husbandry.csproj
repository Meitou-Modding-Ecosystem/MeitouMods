<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Husbandry (docs/husbandry.md): hitching posts that keep assigned animals in a pen, and breeding. Its records are in Husbandry.mod, generated
    from the installed game by Husbandry.Data. Built against the game's assemblies, never copied: the game loads them.
  -->

  <PropertyGroup>
    <AssemblyName>Husbandry</AssemblyName>
    <RootNamespace>Husbandry</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../engine/src/Meitou.Core/Meitou.Core.csproj" Private="false" />
    <ProjectReference Include="../engine/src/Meitou.Data/Meitou.Data.csproj" Private="false" />
    <ProjectReference Include="../engine/src/Meitou.Simulation/Meitou.Simulation.csproj" Private="false" />
    <ProjectReference Include="../engine/src/Meitou.Game/Meitou.Game.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="meitou.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
